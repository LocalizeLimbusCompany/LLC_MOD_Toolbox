<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Exercise the production services without loading the Windows desktop runtime. -->
  <ItemGroup>
    <Compile Include="../../Services/Network/HttpService.cs" Link="Services/HttpService.cs" />
    <Compile Include="../../Services/Network/IHttpService.cs" Link="Services/IHttpService.cs" />
    <Compile Include="../../Services/Network/HttpServiceExtensions.cs" Link="Services/HttpServiceExtensions.cs" />
    <Compile Include="../../Services/Content/LoadingTextService.cs" Link="Services/LoadingTextService.cs" />
    <Compile Include="../../Services/Configuration/ConfigurationService.cs" Link="Services/ConfigurationService.cs" />
    <Compile Include="../../Models/ApplicationState.cs" Link="Models/ApplicationState.cs" />
    <Compile Include="../../Infrastructure/ObservableObject.cs" Link="Infrastructure/ObservableObject.cs" />
    <Compile Include="../../Infrastructure/StartupDiagnostics.cs" Link="Infrastructure/StartupDiagnostics.cs" />
    <Compile Include="../../Models/Configuration/*.cs" Link="Models/Configuration/%(Filename)%(Extension)" />
    <Compile Include="../../Models/Exceptions.cs" Link="Models/Exceptions.cs" />
    <Compile Include="../../Services/Configuration/IConfigurationService.cs" Link="Services/IConfigurationService.cs" />
    <Compile Include="../../Services/Content/ILoadingTextService.cs" Link="Services/ILoadingTextService.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Downloader" Version="5.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Squid-Box.SevenZipSharp" Version="1.6.2.24" />
    <PackageReference Include="log4net" Version="3.3.0" />
  </ItemGroup>
</Project>
